# Copy to supabase/functions/.env for local `supabase functions serve`.
# For deployed functions, set these with `supabase secrets set --env-file
# supabase/functions/.env` instead — never commit the real file, and never
# reference any of these from lib/ (the Flutter app). This is the whole
# reason Phase 0's guardrails exist: these keys can call OpenAI/Perplexity/
# Tavily on the project's behalf and must stay server-side only.

# SUPABASE_SERVICE_ROLE_KEY is auto-injected by the Supabase Edge Functions
# runtime — do not set it manually here.

OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# Comma-separated allowlist the guardrail middleware checks every retrieved
# source against before anything can be marked "verified" (see
# supabase/functions/_shared/allowlist.ts). Extend as new countries/bodies
# are added — never widen this to "any domain".
VERIFIED_SOURCE_DOMAIN_ALLOWLIST=mcc.ca,cpso.on.ca,ahpra.gov.au,immi.homeaffairs.gov.au,immigration.govt.nz,gov.uk,canada.ca,ircc.canada.ca
