# Copy this file to .env and fill in real values. Never commit .env.
#
# This file is bundled into the Flutter app (declared as a pubspec asset)
# and shipped to the browser/device — so only ever put client-safe values
# here. The anon key is *meant* to be public; access control comes from
# Supabase Row-Level Security policies, not from keeping this key secret.
#
# Server-only secrets (service role, OpenAI, Perplexity, Tavily) do NOT go
# in this file — see supabase/functions/.env.example instead. They must
# never be reachable from anything the client downloads.

SUPABASE_URL=
SUPABASE_ANON_KEY=
